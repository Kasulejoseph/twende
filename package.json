  "main": "index.js",
  "scripts": {
    "test": "npm run test:stateless && npm run test:stateful && npm run test:llm",
    "test:all": "npm test && npm run test:slow",
    "test:stateless": "playwright test --project=stateless --workers=4",
    "test:stateful": "playwright test --project=stateful --workers=1",
    "test:llm": "playwright test --project=llm --workers=1",
    "test:slow": "playwright test --project=slow --workers=1",
    "test:smoke": "playwright test --grep @smoke --workers=1",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kasulejoseph/twende.git"
